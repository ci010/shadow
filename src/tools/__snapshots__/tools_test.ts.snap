exports[`tools — base tool definitions as sent to the LLM API are pinned 1`] = `
[
  {
    "type": "function",
    "function": {
      "name": "read",
      "description": "Read a file, list a directory, or fetch a URL. Auto-detects mode from the path. Text supports offset/limit, including URLs and virtual text. Local session paths default to /overview, which includes bounded collaboration previews and links exact /c/<message>.<call> details via short physical references (legacy /calls/<id> paths still work); /full retains payloads. Line ranges match grep on that path; omit ranges for the last 200 lines. Local PNG, JPEG, GIF and WebP images return visual content (max 5 MiB, 25 million pixels); no line paging. Read images directly, not through exec/scripts. Remote image reads are not supported.",
      "parameters": {
        "type": "object",
        "properties": {
          "workspace": {
            "type": "string",
            "description": "For read/write/exec also accepts layerfs: mount IDs (UTF-8 file read/overwrite, sh/bash exec only; no background/node; see layerfs skill). Registered Workspace in the current Project: unique short name, name-ID selector or full Workspace ID. Selects its exact device and directory for this call only. Omit to retain session locality. Unavailable targets fail; no Main fallback or automatic device switch."
          },
          "path": {
            "type": "string",
            "description": "File path, directory path, or URL (http/https)"
          },
          "encoding": {
            "type": "string",
            "enum": [
              "auto",
              "utf-8",
              "shift_jis",
              "gb18030",
              "utf-16le",
              "utf-16be",
              "windows-1252"
            ],
            "description": "Local text files only. Default auto: BOM or strict UTF-8. Specify gb18030, shift_jis, etc. to retry legacy text; never rewrites files."
          },
          "offset": {
            "type": "number",
            "description": "1-based starting line for files, URLs and virtual text. With flag \\"l\\": item index."
          },
          "limit": {
            "type": "number",
            "description": "Number of lines (or items with flag \\"l\\") to read."
          },
          "flag": {
            "type": "string",
            "description": "n = line numbers, r = raw URL text, l = list mode (paginate by items). Combine: \\"nl\\"."
          }
        },
        "required": [
          "path"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "write",
      "description": "Write or edit a file. With \`match\`: find and replace. Creates directories as needed. Returns a short receipt; use view_edit with the returned edit ID for the recorded patch.",
      "parameters": {
        "type": "object",
        "properties": {
          "workspace": {
            "type": "string",
            "description": "For read/write/exec also accepts layerfs: mount IDs (UTF-8 file read/overwrite, sh/bash exec only; no background/node; see layerfs skill). Registered Workspace in the current Project: unique short name, name-ID selector or full Workspace ID. Selects its exact device and directory for this call only. Omit to retain session locality. Unavailable targets fail; no Main fallback or automatic device switch."
          },
          "path": {
            "type": "string",
            "description": "File path"
          },
          "content": {
            "type": "string",
            "description": "Full file content, or replacement text when match is set"
          },
          "match": {
            "type": "string",
            "description": "Exact text to find (LF/CRLF equivalent). Must be nonempty and unique unless flag g is set. No fuzzy matching; edits preserve existing line endings and BOM."
          },
          "flag": {
            "type": "string",
            "description": "g = replace all occurrences, a = append to file"
          },
          "encoding": {
            "type": "string",
            "enum": [
              "utf8",
              "utf8-bom"
            ],
            "description": "Full overwrite only; default utf8. Use utf8-bom for non-ASCII .ps1 files executed by Windows PowerShell 5.1. Edits preserve an existing BOM."
          }
        },
        "required": [
          "path",
          "content"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "plan_write",
      "description": "Write or edit a planning document in Project Home/state/plans/. Shared task status belongs in Work items, not a second checklist.",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "File path relative to Project Home/state/plans/ (e.g. \\"my-plan.md\\"). Subdirectories allowed."
          },
          "content": {
            "type": "string",
            "description": "Full file content, or replacement text when match is set."
          },
          "match": {
            "type": "string",
            "description": "Exact text to find for edit mode (find and replace)."
          }
        },
        "required": [
          "path",
          "content"
        ]
      }
    },
    "optIn": true
  },
  {
    "type": "function",
    "function": {
      "name": "view_edit",
      "description": "View the recorded patch for a write receipt edit ID in this session. Returns plain unified hunks, not the current file. No changes and unavailable diffs are reported explicitly.",
      "parameters": {
        "type": "object",
        "properties": {
          "edit_id": {
            "type": "string",
            "description": "The edit ID returned by write."
          }
        },
        "required": [
          "edit_id"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "exec",
      "description": "Run a command or script. Use \`shell: \\"node\\"\` for inline TypeScript with tool access and infer() for bounded semantic computation; see node-scripting.",
      "parameters": {
        "type": "object",
        "properties": {
          "workspace": {
            "type": "string",
            "description": "For read/write/exec also accepts layerfs: mount IDs (UTF-8 file read/overwrite, sh/bash exec only; no background/node; see layerfs skill). Registered Workspace in the current Project: unique short name, name-ID selector or full Workspace ID. Selects its exact device and directory for this call only. Omit to retain session locality. Unavailable targets fail; no Main fallback or automatic device switch."
          },
          "script": {
            "type": "string",
            "description": "Script to run. For OS shells this is the command string; for \`shell=node\` this is inline TypeScript source. Preserve failures: do not append exit 0 or || true to hide an error. When chaining native commands in PowerShell, check $LASTEXITCODE after each one and propagate failures."
          },
          "shell": {
            "type": "string",
            "description": "Runtime: OS shell name or \`node\` for inline TypeScript. Omitted uses the Runtime default (normally cmd on Windows, sh on Unix). Select powershell/pwsh explicitly for PowerShell syntax; shell syntax is not auto-detected."
          },
          "args": {
            "type": "array",
            "description": "Additional arguments passed to the script.",
            "items": {
              "type": "string"
            }
          },
          "cwd": {
            "type": "string",
            "description": "Working directory (defaults to the committed session cwd)"
          },
          "timeout_ms": {
            "type": "number",
            "description": "Max wait time in milliseconds. 0 = run in background (fire-and-forget). Omit for default (120s). The process is NOT killed on timeout."
          }
        },
        "required": [
          "script"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "search",
      "description": "Search names with glob, content with grep, or the web. Virtual searches return read paths without activating skills, connecting services or launching browsers.",
      "parameters": {
        "type": "object",
        "properties": {
          "workspace": {
            "type": "string",
            "description": "For read/write/exec also accepts layerfs: mount IDs (UTF-8 file read/overwrite, sh/bash exec only; no background/node; see layerfs skill). Registered Workspace in the current Project: unique short name, name-ID selector or full Workspace ID. Selects its exact device and directory for this call only. Omit to retain session locality. Unavailable targets fail; no Main fallback or automatic device switch."
          },
          "query": {
            "type": "string",
            "description": "Glob pattern, regex or web keywords. Use ** to list virtual entries."
          },
          "handler": {
            "type": "string",
            "enum": [
              "grep",
              "glob",
              "web"
            ],
            "description": "Search implementation: grep (content), glob (names), or web. Bare names only; put file/virtual scope in path and web scope in domain."
          },
          "domain": {
            "type": "string",
            "description": "web only: restrict results to a DNS domain, e.g. github.com. No URL, path or site: prefix."
          },
          "path": {
            "type": "string",
            "description": "File/directory search root or v:<folder>[/path]. Defaults to the effective workdir, not the repository root."
          },
          "include": {
            "type": "string",
            "description": "grep only: relative file glob, e.g. **/*.ts. Not the search root."
          },
          "limit": {
            "type": "integer",
            "description": "File/virtual searches: 1-100 results per page (default 100)."
          },
          "offset": {
            "type": "integer",
            "description": "File/virtual searches: nonnegative result offset (default 0)."
          }
        },
        "required": [
          "handler",
          "query"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "invoke_tool",
      "description": "Execute an exact tool name from v:tools, loading it lazily (shared initialization may register sibling tools). To discover tools of an uninitialized source, omit name and pass source with args: {}; this initializes only, without executing a tool. Read v:tools/@sources__ for source metadata. Validates the live schema; invalid arguments return the contract without execution.",
      "parameters": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Exact tool name to execute, active or lazily loadable. Mutually exclusive with source."
          },
          "source": {
            "type": "string",
            "description": "Explicit source initialization only; use args: {} and omit name. Returns tool contracts without executing them."
          },
          "args": {
            "type": "object",
            "description": "Arguments for the named tool, matching its current imported contract."
          },
          "instance": {
            "type": "string",
            "description": "Session browser instance ID from browser_setup or discovery. Required for chrome-devtools tools when multiple instances are open; never a business-tool argument."
          }
        },
        "required": [
          "args"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "continuation",
      "description": "Set a continuation string on a background task. When the task completes and its event fires back to the session, the continuation text will be carried as a prefix in the callback message. Optional for running tasks only; completion is automatic and terminal tasks are never replayed.",
      "parameters": {
        "type": "object",
        "properties": {
          "executionId": {
            "type": "string",
            "description": "Owned bg:... executionId from v:bg or exec. Not a local task/call or remote execution."
          },
          "continuation": {
            "type": "string",
            "description": "Continuation text to carry with the task completion event."
          }
        },
        "required": [
          "executionId",
          "continuation"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "log",
      "description": "Append a structured entry to today's log (memory/events/YYYY-MM-DD.jsonl). Use this to record what happened: who did what, when, and why.",
      "parameters": {
        "type": "object",
        "properties": {
          "who": {
            "type": "string",
            "description": "Actor (person, agent, system). A separate wiki page is not required."
          },
          "summary": {
            "type": "string",
            "description": "Short standalone event briefing (1–280 Unicode code points); include outcome and important uncertainty, not learning audit. Required for new reflector events."
          },
          "what": {
            "type": "string",
            "description": "Action or event description. Be concise."
          },
          "why": {
            "type": "string",
            "description": "Motivation or context for the action. Optional."
          },
          "challenge": {
            "type": "string",
            "description": "Difficulty or blocker encountered during this event. Optional."
          },
          "refs": {
            "type": "array",
            "description": "Related wiki item paths (e.g. \\"memory/topics/heartbeat.md\\"). Optional.",
            "items": {
              "type": "string"
            }
          },
          "session": {
            "type": "string",
            "description": "The session this event belongs to (origin/provenance). Defaults to the current session."
          },
          "key": {
            "type": "string",
            "description": "For learning batches: stable event key, reused on retries (e.g. source message index plus decision name)."
          }
        },
        "required": [
          "who",
          "what"
        ]
      }
    },
    "optIn": true
  },
  {
    "type": "function",
    "function": {
      "name": "session",
      "description": "Create durable peer conversations and register folders. Read/write v:session/self.json for your own metadata/completion. Optionally supply work:{key} for an existing unassigned note you coordinate; the host links and assigns it before initialMessage. Work is a shared notebook, not an execution requirement. Keep goals and rationale in the note, and give the peer only the local objective, constraints and stop condition.",
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "create",
              "update",
              "register_folder"
            ]
          },
          "topic": {
            "type": "string",
            "description": "Required for create/update: stable overarching conversation topic, max 120 characters."
          },
          "focus": {
            "type": "string",
            "description": "Optional current step, max 4000 characters. Display falls back to topic when empty."
          },
          "description": {
            "type": "string",
            "description": "Folder contents description for register_folder only. Not instructions or permission."
          },
          "sessionId": {
            "type": "string",
            "description": "Update only: this session."
          },
          "requestId": {
            "type": "string",
            "description": "Create only: optional UUID; reuse exactly the same request on retry. Initial messages are never replayed."
          },
          "folderId": {
            "type": "string",
            "description": "Create only: current Project folder shortName, name-ID selector or full UUID. Uses the registered folder and its node. Omit for a discussion-only session; never a path."
          },
          "agentType": {
            "type": "string",
            "description": "Create only: agent template name, default general."
          },
          "model": {
            "type": "string",
            "description": "Create only: optional exact model ID from v:models; omission preserves agent/Project defaults."
          },
          "effort": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "xhigh",
              "max"
            ],
            "description": "Create only: optional reasoning effort supported by the selected model; omission preserves agent/Project defaults."
          },
          "workRoot": {
            "type": "string",
            "description": "Create only: optional root Work key for shared context; not an assignment. Omit for ordinary conversations."
          },
          "initialMessage": {
            "type": "string",
            "description": "Create only: optional kickoff request, with the necessary context and source references."
          },
          "work": {
            "type": "object",
            "description": "Create only: {key:string}, an unassigned note coordinated by this session. Link responsibility and contextual questions before kickoff; no adoption protocol."
          },
          "nodeId": {
            "type": "string",
            "description": "register_folder only: explicit runtime inventory device identity (Main or Child). Required from remote sessions; never inferred from a display path."
          },
          "path": {
            "type": "string",
            "description": "register_folder only: absolute existing directory on Main when nodeId is omitted; otherwise an opaque directory path on the explicitly selected device. This does not move data or change this chat workdir."
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "message",
      "description": "Send concise actionable context to an agent in this Project: sessionId + content normally suffice. Relevant context enters its next safe step, without interrupting tools. Your running task accepts corrections to its existing assignment, not another task. Use delivery=queue for subsequent work. Routine progress/acknowledgements archive. Admission is not application or ownership transfer; wait for completion or confirmed cancellation before taking over its files.",
      "parameters": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "description": "Message text to send."
          },
          "delivery": {
            "type": "string",
            "enum": [
              "next-step",
              "queue",
              "silent"
            ],
            "description": "Default next-step: context for current work. queue: a later request after the turn. silent: FYI archive only. Running tasks only accept next-step from their actual parent."
          },
          "sessionId": {
            "type": "string",
            "description": "Target session ID from discovery or a prior receipt, including remote:<id> for an owned A2A conversation. Must not be the current session."
          },
          "intent": {
            "type": "string",
            "enum": [
              "request",
              "question",
              "progress",
              "handoff",
              "acknowledgement"
            ],
            "description": "Progress and acknowledgement default to routine archival; required action/materials use request. handoff does not mutate work ownership."
          },
          "attention": {
            "type": "string",
            "enum": [
              "routine",
              "milestone",
              "blocker",
              "decision",
              "correction"
            ],
            "description": "Routine status is archived by default. Other values require a response and cannot be silent. Do not hide failures or corrections as routine progress."
          },
          "workRoot": {
            "type": "string",
            "description": "Optional existing root Work key in this Project; context only."
          },
          "itemId": {
            "type": "string",
            "description": "Optional existing work item in workRoot; context only."
          },
          "work": {
            "type": "object",
            "description": "Explicit assignment kickoff: {key, assignmentRevision}. Current manager to current assignee only. One durable admission per assignment; unconfirmed attempts are not replayed."
          }
        },
        "required": [
          "content",
          "sessionId"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "ask",
      "description": "Ask in the context of the goal, then wait. kind=input returns text, never permission. kind=decision needs question, two options and default_option; brief is optional. Set workKey for where the issue arose and decisionKey for the ancestor it changes; the host attaches the goal path automatically. Phrase the question as an outcome-level choice. Resolve local implementation choices yourself; a blocked approach may be replaced instead of escalated. Roots ask humans, children ask their stored parent. approved:false permits only investigation or authorized unaffected work. Use reply for pending requests; messages do not answer them.",
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "ask",
              "context",
              "invalidate"
            ],
            "default": "ask",
            "description": "Ask for input, read the decision schema, or invalidate your own recorded premise."
          },
          "kind": {
            "type": "string",
            "enum": [
              "decision",
              "input"
            ],
            "description": "Required for ask: decision preserves decision/authority constraints; input requests plain text without granting permission."
          },
          "workKey": {
            "type": "string",
            "description": "Optional originating work node. Defaults to your focused or only active assignment; never create a work item merely to ask."
          },
          "decisionKey": {
            "type": "string",
            "description": "Optional ancestor of workKey whose goal or approach this choice changes. The host attaches the complete goal path; explain the choice at this level, not as a raw implementation failure."
          },
          "brief": {
            "type": "object",
            "description": "Optional detailed evidence brief, only when useful. The goal path is attached automatically; do not repeat it here. action=context provides the schema."
          },
          "reconsiders": {
            "type": "object",
            "description": "Decision only: earlier reference {sessionId, physicalId, requestId} being revisited after investigation, deferral or invalidation. Historical link only; do not put invalidated premises in sources."
          },
          "reference": {
            "type": "object",
            "description": "For invalidate: own decision reference {sessionId, physicalId, requestId}."
          },
          "reason": {
            "type": "string",
            "description": "For invalidate: which premise changed and why dependent decisions need revalidation."
          },
          "question": {
            "type": "string",
            "description": "A clear question for missing input or a consequential decision."
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 2,
            "maxItems": 2,
            "uniqueItems": true,
            "description": "Decision only: two distinct non-empty suggested choices. The UI automatically provides a third, custom-response entry; do not generate an Other or free-text option."
          },
          "default_option": {
            "type": "string",
            "description": "Decision only: exactly one of options; not human authorization. An unanswered human request is deferred without approval."
          },
          "independent": {
            "type": "boolean",
            "description": "Decision only: explicitly unrelated to waiting child decisions. Otherwise cite the live child in sources when escalating. Cannot combine with sources."
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "description": "Decision only: optional existing references. Copy an answer receipt’s reference, or sessionId, origin.physicalId and id (as requestId) from a received request. Links provide context, not permission. Citing a live direct child links its escalation: deferral/investigation resumes that child without approval. When a child waits, cite it or mark the question independent.",
            "items": {
              "type": "object",
              "properties": {
                "sessionId": {
                  "type": "string"
                },
                "physicalId": {
                  "type": "string"
                },
                "requestId": {
                  "type": "string"
                }
              },
              "required": [
                "sessionId",
                "physicalId",
                "requestId"
              ],
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "reply",
      "description": "Answer a specific pending request using its returned request_id. For a child decision, text must exactly match an offered option. For ordinary local/remote input, text is the requested information, never new authorization. Only the stored parent or remote task owner may reply. Does not send a general message or replace final responses.",
      "parameters": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string",
            "description": "Exact pending request ID from ask notification or remote execution lookup."
          },
          "text": {
            "type": "string",
            "description": "Requested answer, or exact decision option."
          }
        },
        "required": [
          "request_id",
          "text"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "cancel",
      "description": "Cancel one owned execution from v:bg, exec, or subagent. Waits for local work to stop; remote cancellation reports the remote state. Does not delete conversations or roll back side effects.",
      "parameters": {
        "type": "object",
        "properties": {
          "executionId": {
            "type": "string",
            "description": "Execution ID from v:bg: bg:... background work, local task/call ID, or remote:.../executions/...; not a conversation ID."
          }
        },
        "required": [
          "executionId"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "subagent",
      "description": "Create an asynchronous reviewable local task, or invoke a blocking bounded leaf call. Declare review at creation: parent (default) or an independently managed agent. Structured verdicts automatically rerun requested changes in the same worker history; only PASS delivers success. Remote A2A tasks remain legacy one-shot and do not support this review lifecycle. Use session creation for independent long-lived conversations. These are executions, not work items. Blocking calls must use this tool directly, not an exec/invoke bridge.",
      "parameters": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "task",
              "call"
            ],
            "description": "Task returns an executionId immediately; inspect v:bg without polling. Call waits for its final result and cannot coordinate, ask, or delegate. Remote workdirs support task only; call is rejected before creation because remote exec has no foreground lifecycle. Omission defaults to task in a long-lived session; tasks must explicitly choose call."
          },
          "task": {
            "type": "string",
            "description": "Initial work. Required for task/call."
          },
          "model": {
            "type": "string",
            "description": "Task only: optional exact model ID from v:models; omission preserves role defaults. Forbidden in call mode, which always inherits caller settings."
          },
          "effort": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "xhigh",
              "max"
            ],
            "description": "Task only: optional reasoning effort supported by the selected model. Omission inherits existing defaults. Forbidden in call mode, which always inherits caller settings."
          },
          "title": {
            "type": "string",
            "description": "Task only: parent-owned display title, max 120 characters. Supply title and description explicitly; legacy omission derives a title from description. Ignored for call."
          },
          "description": {
            "type": "string",
            "description": "Parent-owned task discovery description (max 4000 characters); the task child cannot change title or description. Call purpose is unchanged."
          },
          "workRoot": {
            "type": "string",
            "description": "Optional root Work key in this Project. The child receives its shared context; omission inherits the parent association."
          },
          "agent_type": {
            "type": "string",
            "description": "Agent role. Defaults to \\"general\\"; explicit call mode inherits the caller role when omitted. Discover local roles and configured a2a:<agent> targets with read(\\"v:agents\\"). Remote targets support task mode only and inherit no local resources."
          },
          "review": {
            "type": "object",
            "description": "Local task review policy. Omission defaults to parent review; agent creates an independent reviewer automatically. PASS alone delivers success; changes rerun the original worker. Calls and A2A do not accept review.",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "parent",
                  "agent"
                ],
                "default": "parent"
              },
              "agent_type": {
                "type": "string",
                "minLength": 1,
                "description": "Agent review only: configured local reviewer role; defaults to verify."
              },
              "max_rounds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10,
                "default": 3,
                "description": "Maximum submissions including the first. Use max_rounds, not maxRounds."
              },
              "criteria": {
                "type": "string",
                "maxLength": 16000,
                "default": ""
              }
            },
            "additionalProperties": false
          },
          "report_to": {
            "type": "string",
            "description": "Session ID to route the final task result to instead of this session. Format: \\"channel:chatId\\". Routing only: this does not grant reviewer or close authority."
          },
          "preload_tools": {
            "type": "object",
            "description": "Tools to preload before the subagent starts. Map of tool name → extra args array. Example: { \\"chrome-devtools\\": [\\"--remote-debugging-port=9223\\"] }. Use empty array for no extra args: { \\"cron\\": [] }."
          },
          "work": {
            "type": "object",
            "description": "Optional {key:string}: shared note assigned to the durable owner. Links this execution and its questions to that goal; does not require adoption or constrain tools. Omission inherits an unambiguous parent focus."
          }
        },
        "required": [
          "description",
          "task"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "sql",
      "description": "Query current Project work and Project conventions. Omit query for the bounded SQL schema. Work/audit tables are read-only. Convention writes require a direct Project-admin human instruction or an exact human-selected decision, not inferred preferences. Project and actor are runtime-bound; remote workdirs never change storage scope.",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Bounded Project SQL. Omit for schema and source guidance."
          },
          "source": {
            "type": "object",
            "description": "Convention mutations only: recorded user evidence or human decision reference; see sql schema."
          }
        },
        "additionalProperties": false
      }
    }
  }
]
`;

