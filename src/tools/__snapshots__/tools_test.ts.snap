exports[`tools — base tool definitions as sent to the LLM API are pinned 1`] = `
[
  {
    "type": "function",
    "function": {
      "name": "read",
      "description": "Read a file, list a directory, or fetch a URL. Auto-detects mode from the path. Use \`offset\` and \`limit\` to page through content.",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "File path, directory path, or URL (http/https)"
          },
          "offset": {
            "type": "number",
            "description": "1-based starting position. For files: line number. With flag \\"l\\": item index."
          },
          "limit": {
            "type": "number",
            "description": "Number of lines (or items with flag \\"l\\") to read."
          },
          "flag": {
            "type": "string",
            "description": "n = line numbers, r = raw URL text, l = list mode (paginate by items). Combine: \\"nl\\"."
          }
        },
        "required": [
          "path"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "write",
      "description": "Write or edit a file. With \`match\`: find and replace. Creates directories as needed.",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "File path"
          },
          "content": {
            "type": "string",
            "description": "Full file content, or replacement text when match is set"
          },
          "match": {
            "type": "string",
            "description": "Exact text to find for edit mode"
          },
          "flag": {
            "type": "string",
            "description": "g = replace all occurrences, a = append to file"
          }
        },
        "required": [
          "path",
          "content"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "plan_write",
      "description": "Write or edit a planning document in .plans/. Shared task status belongs in Initiative items, not a second checklist.",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "File path relative to .plans/ (e.g. \\"my-plan.md\\"). Subdirectories allowed."
          },
          "content": {
            "type": "string",
            "description": "Full file content, or replacement text when match is set."
          },
          "match": {
            "type": "string",
            "description": "Exact text to find for edit mode (find and replace)."
          }
        },
        "required": [
          "path",
          "content"
        ]
      }
    },
    "optIn": true
  },
  {
    "type": "function",
    "function": {
      "name": "exec",
      "description": "Run a command or script. Use \`shell: \\"node\\"\` for inline TypeScript with tool access.",
      "parameters": {
        "type": "object",
        "properties": {
          "script": {
            "type": "string",
            "description": "Script to run. For OS shells this is the command string; for \`shell=node\` this is inline TypeScript source."
          },
          "shell": {
            "type": "string",
            "description": "Runtime: OS shell name or \`node\` for inline TypeScript."
          },
          "args": {
            "type": "array",
            "description": "Additional arguments passed to the script.",
            "items": {
              "type": "string"
            }
          },
          "cwd": {
            "type": "string",
            "description": "Working directory (defaults to workspace root)"
          },
          "timeout_ms": {
            "type": "number",
            "description": "Max wait time in milliseconds. 0 = run in background (fire-and-forget). Omit for default (120s). The process is NOT killed on timeout."
          }
        },
        "required": [
          "script"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "initiative",
      "description": "Query and maintain cross-session initiatives, items, dependencies, and progress in this Project. Project scope and the acting logical session are supplied by the runtime, not SQL arguments. This is shared work state, not another session todo list. Updating a status does not execute a task. Data remains in Project Home even when this session works in a remote folder.\\nInitiatives coordinate work inside this Project's Home. The initiative database is\\nthe sole current authority; legacy projects/<slug>/project.md files are archives.\\nThis is a bounded initiative-only SQL dialect, NOT arbitrary SQLite or runtime DB access.\\n\\nTables:\\ninitiatives(id stable lowercase slug max64, title, goal, context Markdown,\\n status active|completed|cancelled, created_by_session_id, owner_session_id nullable,\\n created_at, updated_at, revision)\\ninitiative_items(id stable lowercase slug max64, initiative_id, title,\\n status pending|in_progress|blocked|done|cancelled, assignee_session_id nullable,\\n blocked_reason nullable, updated_at, revision)\\ninitiative_item_deps(item_id, depends_on_item_id)\\ninitiative_entries(id autogenerated, initiative_id, item_id nullable,\\n author_session_id, kind, content Markdown, created_at)\\nRead-only views: initiative_ready_items (pending/in_progress, all dependencies done),\\n initiative_session_todos (current actor's pending/in_progress/blocked items),\\n initiative_handoffs (active initiatives with an unowned or inactive owner,\\n with needs_attention=1 and owner_activity: active|inactive|unknown|unassigned),\\n initiative_item_activity (item fields plus assignee_activity:\\n active|inactive|unknown|unassigned and needs_attention=1 for nonterminal items with\\n inactive assignees). Both views retain needs_handoff as a deprecated alias for\\n needs_attention; it is ONLY an attention signal, never permission to claim work.\\n Activity is informative, not assignment release. Unknown is not unowned.\\n\\nGrammar: single-table SELECT * or comma-separated columns FROM table\\n [WHERE column op literal AND ...] [ORDER BY column ASC|DESC] [LIMIT 1..200];\\n INSERT INTO table (columns) VALUES (literals);\\n UPDATE table SET column=literal,... WHERE ...;\\n DELETE FROM initiative_item_deps WHERE ... .\\nLiterals: single-quoted SQL strings (escape apostrophe as ''), integers, NULL,\\n actor_session_id(). Operators: = != <> < <= > >= IS NULL IS NOT NULL.\\nNo joins, expressions, aliases, comments, subqueries, CTEs, PRAGMA, DDL, or other SQL.\\nUp to 20 statements/65536 query bytes, 200 returned or affected rows per query,\\n 262144 result bytes; exceeding a bound rolls back the entire query.\\nEvery query is an atomic transaction; changes is the count of user rows affected.\\nIDs/foreign keys and system timestamps/revision/creator/author are immutable.\\nCreation stamps owner and creator with the real calling session. Never supply\\ncreator/author/timestamps/revision or entry ID. Entries are append-only (kind is\\nnote|progress|decision|handoff); audit entries are automatically appended for writes.\\nOnly the owner edits initiative details, structure, or delegates unassigned items.\\nAssignees can edit their assigned item's title/status/blocked_reason and release it.\\nOwners cannot change another assignee's execution status, even when inactive.\\nSetting blocked requires nonempty blocked_reason; clear it when leaving blocked.\\nUse status cancelled instead of deleting initiatives/items. Dependency edges cannot\\ncross initiatives or form cycles. Only active initiatives accept work changes.\\nAn initiative can complete only when all items are done or cancelled, and every\\ndependency of a done item is done. Cancelled items impose no dependency requirement.\\nRecorded assignments cannot be stolen, including by owners or coordinators.\\nOnly the current assignee may release an assigned item; otherwise it remains theirs.\\nOnly the current owner may hand off or release initiative ownership.\\nSleep, idle, recovery, restart, stopped and unknown sessions never release work.\\nOwnership/assignment changes require a WHERE guard on the old owner/assignee\\n(equality or IS NULL) or revision.\\nOnly explicitly unowned initiatives or unassigned items may be claimed by the actor.\\nAn authenticated current owner can hand off/release ownership and a current assignee\\ncan release their item even when inactive or unknown. Missing/deleted session IDs remain recorded;\\nthey require explicit recovery, not an automatic or coordinator takeover.\\nMessages, requests and handoff entries do not change assignments. Consult current\\nwork facts before acting; shared folders do not imply shared work ownership.\\nWhen runtime membership validation is configured, new owner/assignee targets must\\nexist in this Project; IDs from other Projects or missing sessions are rejected.\\nAtomic claim example:\\nUPDATE initiative_items SET assignee_session_id=actor_session_id(), status='in_progress'\\nWHERE id='implement-parser' AND assignee_session_id IS NULL;\\nCheck changes: 1 means claimed, 0 means no match. Never assume a claim succeeded.\\nExplicit owner claim uses owner_session_id=actor_session_id() with\\nWHERE owner_session_id IS NULL (or a matching revision of an unowned initiative).\\nCurrent owners may explicitly hand off ownership with\\na matching old owner/revision guard, or release it by setting owner_session_id=NULL.",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "SQL against the current Project initiative database. A mutation batch is atomic. Check affected row counts when claiming or updating work."
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      }
    },
    "optIn": true
  },
  {
    "type": "function",
    "function": {
      "name": "search",
      "description": "Search files, the web, skills, Project topic sessions, or available tools via the \`space\` scheme. sessions: discovers peer topic goals, scope, folders and Initiative references. skills: returns skill summaries and read paths without activating tools; read a skill to register its declared tools in this session. tools: searches installed MCP indexes without connecting, returning exact names and parameter schemas for invoke_tool. Explicit built-in browser/factory discovery may initialize resources but never executes their tools.",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Glob pattern, regex, or keywords depending on space. For tools: and skills:, empty or omitted query lists entries. Skill search matches name, description, category and instructions."
          },
          "space": {
            "type": "string",
            "description": "grep:[glob] — file contents. glob:[path] — file names. web:[domain] — web search. sessions: — Project peer topic discovery (no activation). skills:[category] — skill discovery without activation. tools:[source] — tool contracts (e.g. tools:mail); tools: searches persisted MCP metadata and active tools without starting configured servers. Browser/factory sources require explicit selection."
          },
          "limit": {
            "type": "integer",
            "description": "Maximum entries per page: tools: 1-10 (default 3), skills: and sessions: 1-20 (default 5)."
          },
          "offset": {
            "type": "integer",
            "default": 0,
            "description": "tools:, skills: and sessions: only. Nonnegative result offset; use nextOffset to continue listing or searching."
          },
          "instance": {
            "type": "string",
            "description": "tools:chrome-devtools only. Session browser instance ID; required when multiple instances are open. Returns that instance's live contracts."
          }
        },
        "required": [
          "space"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "invoke_tool",
      "description": "Execute a tool by its exact name. Known catalog tools are connected lazily; arguments are validated against the current schema before execution. Use search with space \\"tools:\\" to find names, descriptions and schemas. No separate import is required for catalog tools. Skills are optional guidance.",
      "parameters": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the active session tool to execute."
          },
          "args": {
            "type": "object",
            "description": "Arguments for the named tool, matching its current imported contract."
          },
          "instance": {
            "type": "string",
            "description": "Session browser instance ID from browser_setup or discovery. Required for chrome-devtools tools when multiple instances are open; never a business-tool argument."
          }
        },
        "required": [
          "name",
          "args"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "kill",
      "description": "Kill a background task by ID.",
      "parameters": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string",
            "description": "Task ID to kill."
          }
        },
        "required": [
          "task_id"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "continuation",
      "description": "Set a continuation string on a background task. When the task completes and its event fires back to the session, the continuation text will be carried as a prefix in the callback message.",
      "parameters": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string",
            "description": "Background task ID."
          },
          "continuation": {
            "type": "string",
            "description": "Continuation text to carry with the task completion event."
          }
        },
        "required": [
          "task_id",
          "continuation"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "log",
      "description": "Append a structured entry to today's log (memory/events/YYYY-MM-DD.jsonl). Use this to record what happened: who did what, when, and why.",
      "parameters": {
        "type": "object",
        "properties": {
          "who": {
            "type": "string",
            "description": "Entity name — the actor (person, agent, system). Should match a wiki item name."
          },
          "what": {
            "type": "string",
            "description": "Action or event description. Be concise."
          },
          "why": {
            "type": "string",
            "description": "Motivation or context for the action. Optional."
          },
          "challenge": {
            "type": "string",
            "description": "Difficulty or blocker encountered during this event. Optional."
          },
          "refs": {
            "type": "array",
            "description": "Related wiki item paths (e.g. \\"memory/topics/heartbeat.md\\"). Optional.",
            "items": {
              "type": "string"
            }
          },
          "session": {
            "type": "string",
            "description": "The session this event belongs to (origin/provenance). Defaults to the current session."
          }
        },
        "required": [
          "who",
          "what"
        ]
      }
    },
    "optIn": true
  },
  {
    "type": "function",
    "function": {
      "name": "topic",
      "description": "Create an independent, user-visible topic chat in this Project, revise its brief, or register an existing local folder. First search space=\\"sessions:\\" to reuse an existing topic and read v:project/folders to select a folder ID. Topics are peers, not children; creation never transfers Initiative assignments. Use message for subsequent communication.",
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "create",
              "update",
              "register_folder"
            ]
          },
          "title": {
            "type": "string",
            "description": "Required for create/update: concise topic name (max 160 characters)."
          },
          "goal": {
            "type": "string",
            "description": "Required for create/update: intended outcome and acceptance criteria."
          },
          "scope": {
            "type": "string",
            "description": "Required for create/update: owned domain/resources; a brief is not an exclusive Initiative claim."
          },
          "nonGoals": {
            "type": "string",
            "description": "Explicitly excluded work."
          },
          "sessionId": {
            "type": "string",
            "description": "Update only: this topic or a topic managed by the coordinator."
          },
          "requestId": {
            "type": "string",
            "description": "Create only: optional UUID; reuse exactly the same request on retry. Initial messages are never replayed."
          },
          "folderId": {
            "type": "string",
            "description": "Create only: registered Project folder ID. Omit for a discussion-only topic; never a path."
          },
          "agentType": {
            "type": "string",
            "description": "Create only: agent template name, default general. Never orchestrator."
          },
          "initiativeId": {
            "type": "string",
            "description": "Create only: existing shared Initiative ID, optional; not an assignment."
          },
          "initialMessage": {
            "type": "string",
            "description": "Create only: optional kickoff request, with the necessary context and source references."
          },
          "path": {
            "type": "string",
            "description": "register_folder only: absolute existing directory on Main. This does not move data or change this chat workdir."
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "message",
      "description": "Send a request, question, progress report or explicit handoff context to a peer session in this Project. A receipt confirms delivery admission, not agreement, completion or transfer of Initiative assignment. Sleeping topic sessions can receive messages; temporary executions cannot be reused.",
      "parameters": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "description": "Message text to send."
          },
          "sessionId": {
            "type": "string",
            "description": "Target session ID (e.g. \\"discord:123456\\"). Must not be the current session."
          },
          "silent": {
            "type": "boolean",
            "description": "If true, the message is recorded in history but does not trigger a response from the target agent."
          },
          "intent": {
            "type": "string",
            "enum": [
              "request",
              "question",
              "progress",
              "handoff",
              "acknowledgement"
            ],
            "description": "Purpose of this communication; handoff does not mutate work ownership."
          },
          "initiativeId": {
            "type": "string",
            "description": "Optional existing Initiative in this Project."
          },
          "itemId": {
            "type": "string",
            "description": "Optional existing work item in initiativeId."
          }
        },
        "required": [
          "content",
          "sessionId"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "yield",
      "description": "Yield for a decision with exactly three choices and one default. Root sessions ask the human; child sessions ask their stored parent. Waits until answered, cancelled, or the configured timeout selects the default. Use action=\\"answer\\" to answer a child request. You cannot select the recipient or timeout.",
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "ask",
              "answer"
            ],
            "default": "ask",
            "description": "Ask a question or answer a child session’s request."
          },
          "question": {
            "type": "string",
            "description": "For ask: a clear question requiring a decision."
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 3,
            "maxItems": 3,
            "uniqueItems": true,
            "description": "For ask: exactly three distinct non-empty choices."
          },
          "default_option": {
            "type": "string",
            "description": "For ask: exactly one of options, used only if the configured timeout expires."
          },
          "request_id": {
            "type": "string",
            "description": "For answer: the request ID received from your child session."
          },
          "option": {
            "type": "string",
            "description": "For answer: the exact text of one of the child’s three options."
          }
        },
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "event_subscribe",
      "description": "Manage event subscriptions, event sources, and emit custom events. Events are signals that wake a session; declare urgency to control how they arrive (steering=interrupt now, queue=after current turn, debounce=coalesce a burst, silent=record only). Read v:events for subscriptions and v:events/sources for registered sources. Discover tools:cron and use cron_add to schedule periodic events.",
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "description": "subscribe | unsubscribe | emit | register_source | unregister_source | list_sources",
            "enum": [
              "subscribe",
              "unsubscribe",
              "emit",
              "register_source",
              "unregister_source",
              "list_sources"
            ]
          },
          "id": {
            "type": "string",
            "description": "Subscription ID (required for unsubscribe)."
          },
          "event": {
            "type": "string",
            "description": "Event type to match or emit. Use * to subscribe to all."
          },
          "source": {
            "type": "string",
            "description": "Event source tag. For subscribe/emit: filter/label (e.g. channel:web, cron). For register_source/unregister_source: the source tag to define/remove."
          },
          "channel": {
            "type": "string",
            "description": "Optional channel filter for channel.message events."
          },
          "chat_id": {
            "type": "string",
            "description": "Optional chat filter for channel.message events."
          },
          "content": {
            "type": "string",
            "description": "Event payload text when action=emit."
          },
          "meta_json": {
            "type": "string",
            "description": "Optional JSON object string for event metadata."
          },
          "target_session": {
            "type": "string",
            "description": "Optional target session ID; defaults to current session."
          },
          "urgency": {
            "type": "string",
            "description": "Delivery urgency for subscribe/emit/register_source: steering (interrupt), queue (default, after current turn), debounce (coalesce burst), silent (record only).",
            "enum": [
              "steering",
              "queue",
              "debounce",
              "silent"
            ]
          },
          "coalesce_key": {
            "type": "string",
            "description": "Grouping key for debounce coalescing (defaults to \\"<type>:<source>\\")."
          },
          "debounce_ms": {
            "type": "number",
            "description": "Trailing debounce window in ms (default 30000). Only for urgency=debounce."
          },
          "kind": {
            "type": "string",
            "description": "Source category for register_source (default \\"custom\\").",
            "enum": [
              "channel",
              "cron",
              "agent",
              "system",
              "custom"
            ]
          },
          "description": {
            "type": "string",
            "description": "Human description for register_source."
          }
        },
        "required": [
          "action"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "subagent",
      "description": "Create a temporary asynchronous task, or invoke a blocking bounded leaf call. Use topic creation for independent long-lived conversations. Blocking calls must use this tool directly, not an exec/invoke bridge.",
      "parameters": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "task",
              "call"
            ],
            "description": "Task returns an accepted ID immediately. Call waits for its final result and cannot coordinate, yield, or delegate. Omission defaults to task in a long-lived session; tasks must explicitly choose call."
          },
          "task": {
            "type": "string",
            "description": "Initial work. Required for task/call."
          },
          "description": {
            "type": "string",
            "description": "Short description of the sub-agent session's purpose."
          },
          "initiative_id": {
            "type": "string",
            "description": "Existing Initiative ID in this Project. The child receives its shared SQL work context; omission inherits the parent association."
          },
          "agent_type": {
            "type": "string",
            "description": "Agent role. Defaults to \\"general\\"; explicit call mode inherits the caller role when omitted. Available types are listed in the Runtime section of the system prompt."
          },
          "report_to": {
            "type": "string",
            "description": "Session ID to route the final task result to instead of this session. Format: \\"channel:chatId\\". Enables agent chains (e.g., coder → verifier)."
          },
          "preload_tools": {
            "type": "object",
            "description": "Tools to preload before the subagent starts. Map of tool name → extra args array. Example: { \\"chrome-devtools\\": [\\"--remote-debugging-port=9223\\"] }. Use empty array for no extra args: { \\"cron\\": [] }."
          }
        },
        "required": [
          "description",
          "task"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "update_convention",
      "description": "Add or remove a durable convention (always-on constraint / rule). Conventions are injected full-text every turn — keep them short and remove them when no longer in effect. scope: session (this conversation), initiative (shared work within this Project), or agent (this Project agent). Legacy project scope means initiative, never another Project.",
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "add",
              "remove"
            ],
            "description": "Whether to add or remove a convention."
          },
          "scope": {
            "type": "string",
            "enum": [
              "session",
              "initiative",
              "agent",
              "project"
            ],
            "description": "The scope the convention applies to."
          },
          "text": {
            "type": "string",
            "description": "The convention text. For remove, a case-insensitive substring match."
          },
          "initiative_id": {
            "type": "string",
            "description": "Initiative ID for initiative scope; defaults to this session association."
          }
        },
        "required": [
          "action",
          "scope",
          "text"
        ]
      }
    }
  }
]
`;

exports[`tools — tool surface per agent type > encapsulator 1`] = `
read
write
exec
search
continuation
topic
yield
event_subscribe
update_convention
`;

exports[`tools — tool surface per agent type > explore 1`] = `
read
exec
search
yield
`;

