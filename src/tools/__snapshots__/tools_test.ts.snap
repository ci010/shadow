exports[`tools — base tool definitions as sent to the LLM API are pinned 1`] = `
[
  {
    "type": "function",
    "function": {
      "name": "read",
      "description": "Read a file, list a directory, or fetch a URL. Auto-detects mode from the path. Text supports offset/limit, including URLs and virtual text. Session line ranges use the same view as grep; omit ranges for recent messages. Local PNG, JPEG, GIF and WebP images return visual content (max 5 MiB, 25 million pixels); no line paging. Read images directly, not through exec/scripts. Remote image reads are not supported.",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "File path, directory path, or URL (http/https)"
          },
          "offset": {
            "type": "number",
            "description": "1-based starting line for files, URLs and virtual text. With flag \\"l\\": item index."
          },
          "limit": {
            "type": "number",
            "description": "Number of lines (or items with flag \\"l\\") to read."
          },
          "flag": {
            "type": "string",
            "description": "n = line numbers, r = raw URL text, l = list mode (paginate by items). Combine: \\"nl\\"."
          }
        },
        "required": [
          "path"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "write",
      "description": "Write or edit a file. With \`match\`: find and replace. Creates directories as needed. Returns a short receipt; use view_edit with the returned edit ID for the recorded patch.",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "File path"
          },
          "content": {
            "type": "string",
            "description": "Full file content, or replacement text when match is set"
          },
          "match": {
            "type": "string",
            "description": "Exact text to find for edit mode"
          },
          "flag": {
            "type": "string",
            "description": "g = replace all occurrences, a = append to file"
          },
          "encoding": {
            "type": "string",
            "enum": [
              "utf8",
              "utf8-bom"
            ],
            "description": "Full overwrite only; default utf8. Use utf8-bom for non-ASCII .ps1 files executed by Windows PowerShell 5.1. Edits preserve an existing BOM."
          }
        },
        "required": [
          "path",
          "content"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "plan_write",
      "description": "Write or edit a planning document in .plans/. Shared task status belongs in Initiative items, not a second checklist.",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "File path relative to .plans/ (e.g. \\"my-plan.md\\"). Subdirectories allowed."
          },
          "content": {
            "type": "string",
            "description": "Full file content, or replacement text when match is set."
          },
          "match": {
            "type": "string",
            "description": "Exact text to find for edit mode (find and replace)."
          }
        },
        "required": [
          "path",
          "content"
        ]
      }
    },
    "optIn": true
  },
  {
    "type": "function",
    "function": {
      "name": "view_edit",
      "description": "View the recorded patch for a write receipt edit ID in this session. Returns plain unified hunks, not the current file. No changes and unavailable diffs are reported explicitly.",
      "parameters": {
        "type": "object",
        "properties": {
          "edit_id": {
            "type": "string",
            "description": "The edit ID returned by write."
          }
        },
        "required": [
          "edit_id"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "exec",
      "description": "Run a command or script. Use \`shell: \\"node\\"\` for inline TypeScript with tool access and infer() for bounded semantic computation; see node-scripting.",
      "parameters": {
        "type": "object",
        "properties": {
          "script": {
            "type": "string",
            "description": "Script to run. For OS shells this is the command string; for \`shell=node\` this is inline TypeScript source. Preserve failures: do not append exit 0 or || true to hide an error. When chaining native commands in PowerShell, check $LASTEXITCODE after each one and propagate failures."
          },
          "shell": {
            "type": "string",
            "description": "Runtime: OS shell name or \`node\` for inline TypeScript. Omitted uses the Runtime default (normally cmd on Windows, sh on Unix). Select powershell/pwsh explicitly for PowerShell syntax; shell syntax is not auto-detected."
          },
          "args": {
            "type": "array",
            "description": "Additional arguments passed to the script.",
            "items": {
              "type": "string"
            }
          },
          "cwd": {
            "type": "string",
            "description": "Working directory (defaults to workspace root)"
          },
          "timeout_ms": {
            "type": "number",
            "description": "Max wait time in milliseconds. 0 = run in background (fire-and-forget). Omit for default (120s). The process is NOT killed on timeout."
          }
        },
        "required": [
          "script"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "work",
      "description": "Shared work notes and Project goal map, never a prerequisite for tools. create needs data={title,definition:{objective},notes:{kind}}; child notes need relation={kind:supports|requires|assumption,reason}. update needs key, version and only changed fields: data.notes={summary,plan,next,artifacts,html,attention?}, data.status/blockedReason. Workers update their branch; coordinators maintain goals and causal links. Report meaningful findings once here, not again by message. Only attention wakes a coordinator; routine notes update the dashboard silently. context returns current notes and ancestor paths; data.includeSchema=true adds help. No adopt, policy, checkpoint or per-step bookkeeping. Completion is a reported result, not user acceptance. Ask consequential questions at the affected goal with ask workKey/decisionKey.",
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "context",
              "list",
              "tree",
              "create",
              "update",
              "assign",
              "review",
              "select"
            ]
          },
          "key": {
            "type": "string",
            "description": "Stable work key."
          },
          "version": {
            "type": "integer",
            "description": "Current note version for update, assign or review; returned by reads and writes."
          },
          "data": {
            "type": "object",
            "description": "Only action-specific fields. context data.includeSchema=true returns help."
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "search",
      "description": "Search names with glob, content with grep, or the web. Virtual searches return read paths without activating skills, connecting services or launching browsers.",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Glob pattern, regex or web keywords. Use ** to list virtual entries."
          },
          "space": {
            "type": "string",
            "description": "grep or glob with path below; web:[domain] for web search. Legacy grep:[file-glob], grep:v:<folder>[/path] and glob:[path] also work."
          },
          "path": {
            "type": "string",
            "description": "File/directory search root or v:<folder>[/path]. Defaults to the effective workdir, not the repository root."
          },
          "include": {
            "type": "string",
            "description": "grep only: relative file glob, e.g. **/*.ts. Not the search root."
          },
          "limit": {
            "type": "integer",
            "description": "File/virtual searches: 1-100 results per page (default 100)."
          },
          "offset": {
            "type": "integer",
            "description": "File/virtual searches: nonnegative result offset (default 0)."
          }
        },
        "required": [
          "space",
          "query"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "invoke_tool",
      "description": "Execute an exact tool name, loading it lazily. Validates arguments against the current schema; invalid arguments return the contract without execution.",
      "parameters": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the active session tool to execute."
          },
          "args": {
            "type": "object",
            "description": "Arguments for the named tool, matching its current imported contract."
          },
          "instance": {
            "type": "string",
            "description": "Session browser instance ID from browser_setup or discovery. Required for chrome-devtools tools when multiple instances are open; never a business-tool argument."
          }
        },
        "required": [
          "name",
          "args"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "continuation",
      "description": "Set a continuation string on a background task. When the task completes and its event fires back to the session, the continuation text will be carried as a prefix in the callback message. Optional for running tasks only; completion is automatic and terminal tasks are never replayed.",
      "parameters": {
        "type": "object",
        "properties": {
          "executionId": {
            "type": "string",
            "description": "Owned bg:... executionId from v:bg or exec. Not a local task/call or remote execution."
          },
          "continuation": {
            "type": "string",
            "description": "Continuation text to carry with the task completion event."
          }
        },
        "required": [
          "executionId",
          "continuation"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "log",
      "description": "Append a structured entry to today's log (memory/events/YYYY-MM-DD.jsonl). Use this to record what happened: who did what, when, and why.",
      "parameters": {
        "type": "object",
        "properties": {
          "who": {
            "type": "string",
            "description": "Actor (person, agent, system). A separate wiki page is not required."
          },
          "what": {
            "type": "string",
            "description": "Action or event description. Be concise."
          },
          "why": {
            "type": "string",
            "description": "Motivation or context for the action. Optional."
          },
          "challenge": {
            "type": "string",
            "description": "Difficulty or blocker encountered during this event. Optional."
          },
          "refs": {
            "type": "array",
            "description": "Related wiki item paths (e.g. \\"memory/topics/heartbeat.md\\"). Optional.",
            "items": {
              "type": "string"
            }
          },
          "session": {
            "type": "string",
            "description": "The session this event belongs to (origin/provenance). Defaults to the current session."
          },
          "key": {
            "type": "string",
            "description": "For learning batches: stable event key, reused on retries (e.g. source message index plus decision name)."
          }
        },
        "required": [
          "who",
          "what"
        ]
      }
    },
    "optIn": true
  },
  {
    "type": "function",
    "function": {
      "name": "session",
      "description": "Create or name durable peer conversations and register folders. Optionally supply work:{key} for an existing unassigned note you coordinate; the host links and assigns it before initialMessage. Work is a shared notebook, not an execution requirement. Keep goals and rationale in the note, and give the peer only the local objective, constraints and stop condition.",
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "create",
              "update",
              "register_folder"
            ]
          },
          "title": {
            "type": "string",
            "description": "Required for create/update: session name, max 120 characters."
          },
          "description": {
            "type": "string",
            "description": "Optional short discovery description, not a goal, acceptance condition or permission."
          },
          "sessionId": {
            "type": "string",
            "description": "Update only: this session or an ordinary conversation managed by the coordinator."
          },
          "requestId": {
            "type": "string",
            "description": "Create only: optional UUID; reuse exactly the same request on retry. Initial messages are never replayed."
          },
          "folderId": {
            "type": "string",
            "description": "Create only: registered Project folder ID. Omit for a discussion-only session; never a path."
          },
          "agentType": {
            "type": "string",
            "description": "Create only: agent template name, default general. Never orchestrator."
          },
          "initiativeId": {
            "type": "string",
            "description": "Create only: root Work key for an Initiative view (or a legacy Initiative ID), optional; not an assignment."
          },
          "initialMessage": {
            "type": "string",
            "description": "Create only: optional kickoff request, with the necessary context and source references."
          },
          "work": {
            "type": "object",
            "description": "Create only: {key:string}, an unassigned note coordinated by this session. Link responsibility and contextual questions before kickoff; no adoption protocol."
          },
          "path": {
            "type": "string",
            "description": "register_folder only: absolute existing directory on Main. This does not move data or change this chat workdir."
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "message",
      "description": "Send to a peer session in this Project when it needs to act differently. Requests queue without interrupting active work. Prefer one shared work note for findings and progress; do not also message the same status. Routine progress/acknowledgements archive by default. attention marks changes needing a response. Goal/rationale changes belong in work, not prose-only redirection. A receipt is admission, not completion, permission or assignment transfer.",
      "parameters": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "description": "Message text to send."
          },
          "sessionId": {
            "type": "string",
            "description": "Target session ID from discovery or a prior receipt, including remote:<id> for an owned A2A conversation. Must not be the current session."
          },
          "silent": {
            "type": "boolean",
            "description": "False queues a response without interrupting active work; true only archives. Defaults to true for routine progress/acknowledgements, false otherwise. Archival does not update active context or wake a recipient. Never use true for required materials, corrections, questions or instructions."
          },
          "intent": {
            "type": "string",
            "enum": [
              "request",
              "question",
              "progress",
              "handoff",
              "acknowledgement"
            ],
            "description": "Progress and acknowledgement default to routine archival; required action/materials use request. handoff does not mutate work ownership."
          },
          "attention": {
            "type": "string",
            "enum": [
              "routine",
              "milestone",
              "blocker",
              "decision",
              "correction"
            ],
            "description": "Routine status is archived by default. Other values require a response and cannot be silent. Do not hide failures or corrections as routine progress."
          },
          "initiativeId": {
            "type": "string",
            "description": "Optional existing Initiative in this Project."
          },
          "itemId": {
            "type": "string",
            "description": "Optional existing work item in initiativeId."
          }
        },
        "required": [
          "content",
          "sessionId"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "ask",
      "description": "Ask in the context of the goal, then wait. kind=input returns text, never permission. kind=decision needs question, two options and default_option; brief is optional. Set workKey for where the issue arose and decisionKey for the ancestor it changes; the host attaches the goal path automatically. Phrase the question as an outcome-level choice. Resolve local implementation choices yourself; a blocked approach may be replaced instead of escalated. Roots ask humans, children ask their stored parent. approved:false permits only investigation or authorized unaffected work. Use reply for pending requests; messages do not answer them.",
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "ask",
              "context",
              "invalidate"
            ],
            "default": "ask",
            "description": "Ask for input, read the decision schema, or invalidate your own recorded premise."
          },
          "kind": {
            "type": "string",
            "enum": [
              "decision",
              "input"
            ],
            "description": "Required for ask: decision preserves decision/authority constraints; input requests plain text without granting permission."
          },
          "workKey": {
            "type": "string",
            "description": "Optional originating work node. Defaults to your focused or only active assignment; never create a work item merely to ask."
          },
          "decisionKey": {
            "type": "string",
            "description": "Optional ancestor of workKey whose goal or approach this choice changes. The host attaches the complete goal path; explain the choice at this level, not as a raw implementation failure."
          },
          "brief": {
            "type": "object",
            "description": "Optional detailed evidence brief, only when useful. The goal path is attached automatically; do not repeat it here. action=context provides the schema."
          },
          "reconsiders": {
            "type": "object",
            "description": "Decision only: earlier reference {sessionId, physicalId, requestId} being revisited after investigation, deferral or invalidation. Historical link only; do not put invalidated premises in sources."
          },
          "reference": {
            "type": "object",
            "description": "For invalidate: own decision reference {sessionId, physicalId, requestId}."
          },
          "reason": {
            "type": "string",
            "description": "For invalidate: which premise changed and why dependent decisions need revalidation."
          },
          "question": {
            "type": "string",
            "description": "A clear question for missing input or a consequential decision."
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 2,
            "maxItems": 2,
            "uniqueItems": true,
            "description": "Decision only: two distinct non-empty suggested choices. The UI automatically provides a third, custom-response entry; do not generate an Other or free-text option."
          },
          "default_option": {
            "type": "string",
            "description": "Decision only: exactly one of options, used only if the configured timeout expires."
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "description": "Decision only: optional existing references. Copy an answer receipt’s reference, or sessionId, origin.physicalId and id (as requestId) from a received request. Links provide context, not permission or proof of causation.",
            "items": {
              "type": "object",
              "properties": {
                "sessionId": {
                  "type": "string"
                },
                "physicalId": {
                  "type": "string"
                },
                "requestId": {
                  "type": "string"
                }
              },
              "required": [
                "sessionId",
                "physicalId",
                "requestId"
              ],
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "reply",
      "description": "Answer a specific pending request using its returned request_id. For a child decision, text must exactly match an offered option. For ordinary local/remote input, text is the requested information, never new authorization. Only the stored parent or remote task owner may reply. Does not send a general message or replace final responses.",
      "parameters": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string",
            "description": "Exact pending request ID from ask notification or remote execution lookup."
          },
          "text": {
            "type": "string",
            "description": "Requested answer, or exact decision option."
          }
        },
        "required": [
          "request_id",
          "text"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "cancel",
      "description": "Cancel one owned execution from v:bg, exec, or subagent. Waits for local work to stop; remote cancellation reports the remote state. Does not delete conversations or roll back side effects.",
      "parameters": {
        "type": "object",
        "properties": {
          "executionId": {
            "type": "string",
            "description": "Execution ID from v:bg: bg:... background work, local task/call ID, or remote:.../executions/...; not a conversation ID."
          }
        },
        "required": [
          "executionId"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "subagent",
      "description": "Create a temporary asynchronous task, or invoke a blocking bounded leaf call. Use session creation for independent long-lived conversations. These are executions, not work items. Blocking calls must use this tool directly, not an exec/invoke bridge.",
      "parameters": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "task",
              "call"
            ],
            "description": "Task returns an executionId immediately; inspect v:bg without polling. Call waits for its final result and cannot coordinate, ask, or delegate. Omission defaults to task in a long-lived session; tasks must explicitly choose call."
          },
          "task": {
            "type": "string",
            "description": "Initial work. Required for task/call."
          },
          "description": {
            "type": "string",
            "description": "Short description of the sub-agent session's purpose."
          },
          "initiative_id": {
            "type": "string",
            "description": "Existing Initiative ID in this Project. The child receives its shared SQL work context; omission inherits the parent association."
          },
          "agent_type": {
            "type": "string",
            "description": "Agent role. Defaults to \\"general\\"; explicit call mode inherits the caller role when omitted. Discover local roles and configured a2a:<agent> targets with read(\\"v:agents\\"). Remote targets support task mode only and inherit no local resources."
          },
          "report_to": {
            "type": "string",
            "description": "Session ID to route the final task result to instead of this session. Format: \\"channel:chatId\\". Enables agent chains (e.g., coder → verifier)."
          },
          "preload_tools": {
            "type": "object",
            "description": "Tools to preload before the subagent starts. Map of tool name → extra args array. Example: { \\"chrome-devtools\\": [\\"--remote-debugging-port=9223\\"] }. Use empty array for no extra args: { \\"cron\\": [] }."
          },
          "work": {
            "type": "object",
            "description": "Optional {key:string}: shared note assigned to the durable owner. Links this execution and its questions to that goal; does not require adoption or constrain tools. Omission inherits an unambiguous parent focus."
          }
        },
        "required": [
          "description",
          "task"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "sql",
      "description": "Query current Project work and Project conventions. Omit query for the bounded SQL schema. Work/audit tables are read-only. Convention writes require a direct Project-admin human instruction or an exact human-selected decision, not inferred preferences. Project and actor are runtime-bound; remote workdirs never change storage scope.",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Bounded Project SQL. Omit for schema and source guidance."
          },
          "source": {
            "type": "object",
            "description": "Convention mutations only: recorded user evidence or human decision reference; see sql schema."
          }
        },
        "additionalProperties": false
      }
    }
  }
]
`;

exports[`tools — tool surface per agent type > a2a-text 1`] = `

`;

exports[`tools — tool surface per agent type > encapsulator 1`] = `
read
write
view_edit
search
`;

exports[`tools — tool surface per agent type > explore 1`] = `
read
exec
work
search
ask
reply
`;

exports[`tools — tool surface per agent type > general 1`] = `
read
write
view_edit
exec
work
search
invoke_tool
continuation
session
message
ask
reply
cancel
subagent
sql
`;

exports[`tools — tool surface per agent type > general-legacy 1`] = `
read
write
view_edit
exec
work
search
invoke_tool
continuation
session
message
ask
reply
cancel
subagent
sql
`;

exports[`tools — tool surface per agent type > orchestrator 1`] = `
read
work
search
session
message
ask
reply
sql
`;

exports[`tools — tool surface per agent type > plan 1`] = `
read
plan_write
work
search
ask
reply
`;

exports[`tools — tool surface per agent type > reflector 1`] = `
read
write
view_edit
search
log
`;

exports[`tools — tool surface per agent type > soul-reflector 1`] = `
read
search
`;

exports[`tools — tool surface per agent type > sub 1`] = `
read
write
view_edit
exec
work
search
invoke_tool
continuation
session
message
ask
reply
cancel
subagent
sql
`;

exports[`tools — tool surface per agent type > verify 1`] = `
read
exec
work
search
ask
reply
`;
