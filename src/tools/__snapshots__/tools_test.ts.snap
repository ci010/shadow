exports[`tools — base tool definitions as sent to the LLM API are pinned 1`] = `
[
  {
    "type": "function",
    "function": {
      "name": "read",
      "description": "Read a file, list a directory, or fetch a URL. Auto-detects mode from the path. Text supports offset/limit. Local PNG, JPEG, GIF and WebP images return visual content (max 5 MiB, 25 million pixels); no line paging. Read images directly, not through exec/scripts. Remote image reads are not supported.",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "File path, directory path, or URL (http/https)"
          },
          "offset": {
            "type": "number",
            "description": "1-based starting position. For files: line number. With flag \\"l\\": item index."
          },
          "limit": {
            "type": "number",
            "description": "Number of lines (or items with flag \\"l\\") to read."
          },
          "flag": {
            "type": "string",
            "description": "n = line numbers, r = raw URL text, l = list mode (paginate by items). Combine: \\"nl\\"."
          }
        },
        "required": [
          "path"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "write",
      "description": "Write or edit a file. With \`match\`: find and replace. Creates directories as needed.",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "File path"
          },
          "content": {
            "type": "string",
            "description": "Full file content, or replacement text when match is set"
          },
          "match": {
            "type": "string",
            "description": "Exact text to find for edit mode"
          },
          "flag": {
            "type": "string",
            "description": "g = replace all occurrences, a = append to file"
          }
        },
        "required": [
          "path",
          "content"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "plan_write",
      "description": "Write or edit a planning document in .plans/. Shared task status belongs in Initiative items, not a second checklist.",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "File path relative to .plans/ (e.g. \\"my-plan.md\\"). Subdirectories allowed."
          },
          "content": {
            "type": "string",
            "description": "Full file content, or replacement text when match is set."
          },
          "match": {
            "type": "string",
            "description": "Exact text to find for edit mode (find and replace)."
          }
        },
        "required": [
          "path",
          "content"
        ]
      }
    },
    "optIn": true
  },
  {
    "type": "function",
    "function": {
      "name": "exec",
      "description": "Run a command or script. Use \`shell: \\"node\\"\` for inline TypeScript with tool access.",
      "parameters": {
        "type": "object",
        "properties": {
          "script": {
            "type": "string",
            "description": "Script to run. For OS shells this is the command string; for \`shell=node\` this is inline TypeScript source."
          },
          "shell": {
            "type": "string",
            "description": "Runtime: OS shell name or \`node\` for inline TypeScript."
          },
          "args": {
            "type": "array",
            "description": "Additional arguments passed to the script.",
            "items": {
              "type": "string"
            }
          },
          "cwd": {
            "type": "string",
            "description": "Working directory (defaults to workspace root)"
          },
          "timeout_ms": {
            "type": "number",
            "description": "Max wait time in milliseconds. 0 = run in background (fire-and-forget). Omit for default (120s). The process is NOT killed on timeout."
          }
        },
        "required": [
          "script"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "work",
      "description": "Manage work items: definitions, assignments, dependencies, progress and versioned adoption in one place. Read context for schemas; list finds Project work and tree derives an Initiative view. Create work only when executing or tracking it, not for ordinary conversation. Propose material changes for one human review via ask or the Work panel. Session creation is independent. Only the assigned executor adopts and reports progress; execution completion is not acceptance.",
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "context",
              "list",
              "tree",
              "create",
              "update",
              "propose",
              "assign",
              "manage",
              "progress",
              "dependencies",
              "adopt",
              "checkpoint",
              "transition",
              "settle",
              "select"
            ]
          },
          "key": {
            "type": "string",
            "description": "Work key returned by context."
          },
          "revision": {
            "type": "integer",
            "description": "Exact current semantic revision for mutations and selection."
          },
          "data": {
            "type": "object",
            "description": "Action-specific bounded payload; obtain its schema with context."
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "search",
      "description": "Search names with glob, content with grep, or the web. Virtual searches return read paths without activating skills, connecting services or launching browsers.",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Glob pattern, regex or web keywords. Use ** to list virtual entries."
          },
          "space": {
            "type": "string",
            "description": "grep:[file-glob] or grep:v:<folder>[/path] — contents. glob:[path] — names. Virtual folders: skills, memory, sessions, tools. web:[domain] — web search."
          },
          "limit": {
            "type": "integer",
            "description": "Virtual searches only: 1-100 results per page (default 100)."
          },
          "offset": {
            "type": "integer",
            "description": "Virtual searches only: nonnegative result offset (default 0)."
          }
        },
        "required": [
          "space",
          "query"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "invoke_tool",
      "description": "Execute an exact tool name, loading it lazily. Validates arguments against the current schema; invalid arguments return the contract without execution.",
      "parameters": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the active session tool to execute."
          },
          "args": {
            "type": "object",
            "description": "Arguments for the named tool, matching its current imported contract."
          },
          "instance": {
            "type": "string",
            "description": "Session browser instance ID from browser_setup or discovery. Required for chrome-devtools tools when multiple instances are open; never a business-tool argument."
          }
        },
        "required": [
          "name",
          "args"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "continuation",
      "description": "Set a continuation string on a background task. When the task completes and its event fires back to the session, the continuation text will be carried as a prefix in the callback message.",
      "parameters": {
        "type": "object",
        "properties": {
          "executionId": {
            "type": "string",
            "description": "Owned bg:... executionId from v:bg or exec. Not a local task/call or remote execution."
          },
          "continuation": {
            "type": "string",
            "description": "Continuation text to carry with the task completion event."
          }
        },
        "required": [
          "executionId",
          "continuation"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "log",
      "description": "Append a structured entry to today's log (memory/events/YYYY-MM-DD.jsonl). Use this to record what happened: who did what, when, and why.",
      "parameters": {
        "type": "object",
        "properties": {
          "who": {
            "type": "string",
            "description": "Entity name — the actor (person, agent, system). Should match a wiki item name."
          },
          "what": {
            "type": "string",
            "description": "Action or event description. Be concise."
          },
          "why": {
            "type": "string",
            "description": "Motivation or context for the action. Optional."
          },
          "challenge": {
            "type": "string",
            "description": "Difficulty or blocker encountered during this event. Optional."
          },
          "refs": {
            "type": "array",
            "description": "Related wiki item paths (e.g. \\"memory/topics/heartbeat.md\\"). Optional.",
            "items": {
              "type": "string"
            }
          },
          "session": {
            "type": "string",
            "description": "The session this event belongs to (origin/provenance). Defaults to the current session."
          }
        },
        "required": [
          "who",
          "what"
        ]
      }
    },
    "optIn": true
  },
  {
    "type": "function",
    "function": {
      "name": "session",
      "description": "Create or name durable peer conversations and register local folders. Metadata is for discovery, not a work definition. Creation never creates work or transfers assignments; put requests in initialMessage and manage work with work.",
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "create",
              "update",
              "register_folder"
            ]
          },
          "title": {
            "type": "string",
            "description": "Required for create/update: session name, max 120 characters."
          },
          "description": {
            "type": "string",
            "description": "Optional short discovery description, not a goal, acceptance condition or permission."
          },
          "sessionId": {
            "type": "string",
            "description": "Update only: this session or an ordinary conversation managed by the coordinator."
          },
          "requestId": {
            "type": "string",
            "description": "Create only: optional UUID; reuse exactly the same request on retry. Initial messages are never replayed."
          },
          "folderId": {
            "type": "string",
            "description": "Create only: registered Project folder ID. Omit for a discussion-only session; never a path."
          },
          "agentType": {
            "type": "string",
            "description": "Create only: agent template name, default general. Never orchestrator."
          },
          "initiativeId": {
            "type": "string",
            "description": "Create only: root Work key for an Initiative view (or a legacy Initiative ID), optional; not an assignment."
          },
          "initialMessage": {
            "type": "string",
            "description": "Create only: optional kickoff request, with the necessary context and source references."
          },
          "path": {
            "type": "string",
            "description": "register_folder only: absolute existing directory on Main. This does not move data or change this chat workdir."
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "message",
      "description": "Send to a peer session in this Project. Requests queue without interrupting active work. Routine progress/acknowledgements are archived by default to avoid report loops; attention marks milestones, blockers, decisions or corrections that need a response. Use work for versioned goal changes, not prose-only redirection. A receipt is admission, not adoption/completion/assignment transfer.",
      "parameters": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "description": "Message text to send."
          },
          "sessionId": {
            "type": "string",
            "description": "Target session ID from discovery or a prior receipt, including remote:<id> for an owned A2A conversation. Must not be the current session."
          },
          "silent": {
            "type": "boolean",
            "description": "False queues a response without interrupting active work; true only archives. Defaults to true for routine progress/acknowledgements, false otherwise. Archival does not update active context or wake a recipient. Never use true for required materials, corrections, questions or instructions."
          },
          "intent": {
            "type": "string",
            "enum": [
              "request",
              "question",
              "progress",
              "handoff",
              "acknowledgement"
            ],
            "description": "Progress and acknowledgement default to routine archival; required action/materials use request. handoff does not mutate work ownership."
          },
          "attention": {
            "type": "string",
            "enum": [
              "routine",
              "milestone",
              "blocker",
              "decision",
              "correction"
            ],
            "description": "Routine status is archived by default. Other values require a response and cannot be silent. Do not hide failures or corrections as routine progress."
          },
          "initiativeId": {
            "type": "string",
            "description": "Optional existing Initiative in this Project."
          },
          "itemId": {
            "type": "string",
            "description": "Optional existing work item in initiativeId."
          }
        },
        "required": [
          "content",
          "sessionId"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "ask",
      "description": "Ask and wait for required input. kind=input takes only question and returns text, never permission; an inbound A2A input goes to its authenticated caller. kind=decision requires a brief, options and default_option: read action=context for the schema and genuine source identities. Roots ask humans; children ask their stored parent. approved:false is not an answer: investigate or continue only authorized unaffected work. action=invalidate marks your obsolete decision premise. Use reply to answer a pending request; message/final text does not answer it.",
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "ask",
              "context",
              "invalidate"
            ],
            "default": "ask",
            "description": "Ask for input, read the decision schema, or invalidate your own recorded premise."
          },
          "kind": {
            "type": "string",
            "enum": [
              "decision",
              "input"
            ],
            "description": "Required for ask: decision preserves decision/authority constraints; input requests plain text without granting permission."
          },
          "proposal": {
            "type": "object",
            "description": "Decision only: {key,id} from work propose. The exact saved change is displayed for one human approval; do not supply question/options/default_option for this form.",
            "properties": {
              "key": {
                "type": "string"
              },
              "id": {
                "type": "string"
              }
            },
            "required": [
              "key",
              "id"
            ],
            "additionalProperties": false
          },
          "brief": {
            "type": "object",
            "description": "Decision only: required structured brief. Call action=context for the compact schema and genuine user-input references."
          },
          "reconsiders": {
            "type": "object",
            "description": "Decision only: earlier reference {sessionId, physicalId, requestId} being revisited after investigation, deferral or invalidation. Historical link only; do not put invalidated premises in sources."
          },
          "reference": {
            "type": "object",
            "description": "For invalidate: own decision reference {sessionId, physicalId, requestId}."
          },
          "reason": {
            "type": "string",
            "description": "For invalidate: which premise changed and why dependent decisions need revalidation."
          },
          "question": {
            "type": "string",
            "description": "A clear question for missing input or a consequential decision."
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 2,
            "maxItems": 2,
            "uniqueItems": true,
            "description": "Decision only: two distinct non-empty suggested choices. The UI automatically provides a third, custom-response entry; do not generate an Other or free-text option."
          },
          "default_option": {
            "type": "string",
            "description": "Decision only: exactly one of options, used only if the configured timeout expires."
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "description": "Decision only: optional existing references. Copy an answer receipt’s reference, or sessionId, origin.physicalId and id (as requestId) from a received request. Links provide context, not permission or proof of causation.",
            "items": {
              "type": "object",
              "properties": {
                "sessionId": {
                  "type": "string"
                },
                "physicalId": {
                  "type": "string"
                },
                "requestId": {
                  "type": "string"
                }
              },
              "required": [
                "sessionId",
                "physicalId",
                "requestId"
              ],
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "reply",
      "description": "Answer a specific pending request using its returned request_id. For a child decision, text must exactly match an offered option. For ordinary local/remote input, text is the requested information, never new authorization. Only the stored parent or remote task owner may reply. Does not send a general message or replace final responses.",
      "parameters": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string",
            "description": "Exact pending request ID from ask notification or remote execution lookup."
          },
          "text": {
            "type": "string",
            "description": "Requested answer, or exact decision option."
          }
        },
        "required": [
          "request_id",
          "text"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "cancel",
      "description": "Cancel one owned execution from v:bg, exec, or subagent. Waits for local work to stop; remote cancellation reports the remote state. Does not delete conversations or roll back side effects.",
      "parameters": {
        "type": "object",
        "properties": {
          "executionId": {
            "type": "string",
            "description": "Execution ID from v:bg: bg:... background work, local task/call ID, or remote:.../executions/...; not a conversation ID."
          }
        },
        "required": [
          "executionId"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "subagent",
      "description": "Create a temporary asynchronous task, or invoke a blocking bounded leaf call. Use session creation for independent long-lived conversations. These are executions, not work items. Blocking calls must use this tool directly, not an exec/invoke bridge.",
      "parameters": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "task",
              "call"
            ],
            "description": "Task returns an executionId immediately; inspect v:bg without polling. Call waits for its final result and cannot coordinate, ask, or delegate. Omission defaults to task in a long-lived session; tasks must explicitly choose call."
          },
          "task": {
            "type": "string",
            "description": "Initial work. Required for task/call."
          },
          "description": {
            "type": "string",
            "description": "Short description of the sub-agent session's purpose."
          },
          "initiative_id": {
            "type": "string",
            "description": "Existing Initiative ID in this Project. The child receives its shared SQL work context; omission inherits the parent association."
          },
          "agent_type": {
            "type": "string",
            "description": "Agent role. Defaults to \\"general\\"; explicit call mode inherits the caller role when omitted. Discover local roles and configured a2a:<agent> targets with read(\\"v:agents\\"). Remote targets support task mode only and inherit no local resources."
          },
          "report_to": {
            "type": "string",
            "description": "Session ID to route the final task result to instead of this session. Format: \\"channel:chatId\\". Enables agent chains (e.g., coder → verifier)."
          },
          "preload_tools": {
            "type": "object",
            "description": "Tools to preload before the subagent starts. Map of tool name → extra args array. Example: { \\"chrome-devtools\\": [\\"--remote-debugging-port=9223\\"] }. Use empty array for no extra args: { \\"cron\\": [] }."
          }
        },
        "required": [
          "description",
          "task"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "sql",
      "description": "Query current Project work and Project conventions. Omit query for the bounded SQL schema. Work/audit tables are read-only. Convention writes require a direct Project-admin human instruction or an exact human-selected decision, not inferred preferences. Project and actor are runtime-bound; remote workdirs never change storage scope.",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Bounded Project SQL. Omit for schema and source guidance."
          },
          "source": {
            "type": "object",
            "description": "Convention mutations only: recorded user evidence or human decision reference; see sql schema."
          }
        },
        "additionalProperties": false
      }
    }
  }
]
`;

