{
  "name": "@shadow/shadow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist/src"
  ],
  "packageManager": "pnpm@12.3.1",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx scripts/dev.ts",
    "dev:server": "node --env-file-if-exists=.env --import tsx --inspect --watch src/index.ts",
    "dev:app": "pnpm --filter @shadow/app dev",
    "dev:docker": "node --env-file-if-exists=.env --import tsx --inspect=0.0.0.0:9229 --watch src/index.ts",
    "dev:docker:compose": "docker compose up --build",
    "dev:searxng": "docker compose -f docker-compose.searxng.yml up -d",
    "start": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "build": "node --import tsx build.ts",
    "build:app": "pnpm --filter @shadow/app build",
    "build:all": "pnpm build && pnpm build:app",
    "test": "node --import tsx --test \"src/**/*_test.ts\" \"scripts/*_test.ts\" \"app/src/*_test.ts\"",
    "test:update": "node --import tsx --test --test-update-snapshots \"src/**/*_test.ts\" \"scripts/*_test.ts\" \"app/src/*_test.ts\"",
    "test:desktop": "pnpm --filter @shadow/desktop test",
    "test:packaged": "node --import tsx scripts/verify-desktop.ts",
    "typecheck": "tsc --noEmit && pnpm --filter @shadow/desktop typecheck",
    "desktop": "node --import tsx scripts/desktop.ts build",
    "desktop:dev": "node --import tsx scripts/desktop.ts dev",
    "pair:child": "node --import tsx scripts/pair-child.ts",
    "migrate:sessions": "node --import tsx scripts/migrate-sessions-to-sqlite.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@hono/node-ws": "^1.3.1",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "croner": "^10.0.1",
    "hono": "4.13.5",
    "node-html-markdown": "^1.3.0",
    "ws": "^8.21.3",
    "yaml": "^2.9.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
