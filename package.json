{
  "name": "@shadow/shadow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@12.3.1",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx scripts/desktop.ts dev",
    "start": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "a2a:bridge": "node --import tsx integrations/a2a/cli.ts",
    "a2a:mcp": "node --import tsx src/a2a/mcp-cli.ts",
    "build": "node --import tsx build.ts",
    "build:app": "pnpm --filter @shadow/app build",
    "build:all": "pnpm build && pnpm build:app",
    "test": "node --import tsx --test \"src/**/*_test.ts\" \"scripts/*_test.ts\" \"app/src/*_test.ts\" \"integrations/a2a/*_test.ts\"",
    "test:update": "node --import tsx --test --test-update-snapshots \"src/**/*_test.ts\" \"scripts/*_test.ts\" \"app/src/*_test.ts\"",
    "test:desktop": "pnpm --filter @shadow/desktop test",
    "test:packaged": "node --import tsx scripts/verify-desktop.ts",
    "test:release": "node --import tsx --test --test-concurrency=1 scripts/*_test.ts src/runtime/service-mode_test.ts src/runtime/runtime-cli_test.ts src/execution/network/*_test.ts && node --import tsx --test app/src/vite_test.ts && pnpm test:desktop",
    "typecheck": "tsc --noEmit && pnpm --filter @shadow/a2a-bridge typecheck && pnpm --filter @shadow/desktop typecheck && pnpm --filter @shadow/app typecheck",
    "desktop": "node --import tsx scripts/desktop.ts build",
    "desktop:install": "node --import tsx scripts/install-local.ts",
    "desktop:build": "node --import tsx scripts/desktop.ts build",
    "desktop:prepare-aria2": "node --import tsx scripts/local-aria2.ts",
    "release": "node --import tsx scripts/release-mac.ts",
    "desktop:package": "node --import tsx scripts/desktop.ts package",
    "release:prepare": "node --import tsx scripts/prepared-build.ts prepare",
    "release:verify-prepared": "node --import tsx scripts/prepared-build.ts verify",
    "pair:child": "node --import tsx scripts/pair-child.ts",
    "web:pair": "node --import tsx scripts/web-pair.ts",
    "mobile:pair": "node --import tsx scripts/mobile-pair.ts",
    "mobile:build": "pnpm --filter @shadow/mobile build",
    "mobile:sync": "pnpm --filter @shadow/mobile sync",
    "mobile:check": "pnpm --filter @shadow/mobile check",
    "mobile:android": "pnpm --filter @shadow/mobile android",
    "mobile:ios": "pnpm --filter @shadow/mobile ios",
    "test:mobile": "node --import tsx --test src/gateway/mobile-access_test.ts src/runtime/mobile-pairing-cli_test.ts src/runtime/main/mobile-integration_test.ts app/src/mobile*_test.ts scripts/mobile_test.ts"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.1.0",
    "@hono/node-server": "^1.19.17",
    "@hono/node-ws": "^1.3.1",
    "@jsquash/png": "3.1.1",
    "@jsquash/webp": "1.5.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "croner": "^10.0.1",
    "diff": "^8.0.2",
    "hono": "4.13.5",
    "image-size": "^2.0.2",
    "node-html-markdown": "^1.3.0",
    "undici": "^7.29.0",
    "ws": "^8.21.3",
    "yaml": "^2.9.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@electron/asar": "^4.0.1",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "8.2.2"
  }
}
