{
  "agent": {
    "model": "gpt-6-astra@copilot",
    "reasoningEffort": "medium",
    "workspace": "./workspace",
    "sessionStorage": "sqlite"
  },
  "channels": {
    "web": {
      "enabled": true
    }
  },
  "tools": {
    "webSearchProvider": "auto",
    "restrictToWorkspace": true,
    "yield": {
      "timeoutMs": null
    },
    "sessionRetirement": {
      "enabled": false,
      "inactivityDays": 5
    }
  }
}
