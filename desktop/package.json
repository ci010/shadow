{
  "name": "@shadow/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "start": "electron .",
    "test:state": "node --import tsx --test src/wizard/state-machine.node-test.ts",
    "test": "node --import tsx --test \"src/**/*.node-test.ts\"",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm clean && tsc -p tsconfig.build.json && esbuild src/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload.cjs",
    "dist": "electron-builder --publish never"
  },
  "build": {
    "appId": "com.shadow.app",
    "productName": "Shadow",
    "asar": true,
    "publish": [],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*.js",
      "dist/**/*.cjs",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "release-manifest.v1.json",
        "to": "release-manifest.v1.json"
      },
      {
        "from": "backend",
        "to": "backend",
        "filter": ["dist/**/*", "package.json", "!**/*.map"]
      },
      {
        "from": "backend/node_modules",
        "to": "backend/node_modules",
        "filter": ["**/*"]
      },
      {
        "from": "aria2",
        "to": "aria2",
        "filter": ["COPYING", "LICENSE.OpenSSL", "aria2-1.37.0-source.tar.gz", "BUILD.md", "build-aria2-native.sh"]
      },
      {
        "from": "../app/dist",
        "to": "app-dist"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "extraResources": [
        { "from": "service", "to": "service", "filter": ["**/*"] },
        { "from": "aria2/aria2c.exe", "to": "aria2/aria2c.exe" }
      ]
    },
    "mac": {
      "target": "zip",
      "icon": "assets/icon.png",
      "category": "public.app-category.productivity",
      "identity": "-",
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "notarize": false,
      "extraResources": [
        { "from": "aria2/aria2c", "to": "aria2/aria2c" }
      ]
    },
    "linux": {
      "target": "tar.gz",
      "icon": "assets/icon.png",
      "category": "Utility",
      "executableName": "shadow",
      "extraResources": [
        { "from": "aria2/aria2c", "to": "aria2/aria2c" }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.9",
    "electron": "44.1.1",
    "electron-builder": "26.16.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
