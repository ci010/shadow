+#[test]
+fn direct_bridge_is_explicit_and_fail_closed_on_the_exact_inspection() {
+    use layerfs_sandbox::{backend::docker::Sandbox, ContainerId};
+    let good = r#"{"bridge":{"IPAddress":"172.17.0.2"}}"#;
+    for (networks, labels, host, accepted) in [
+        (good, ALL, "127.0.0.1", true),
+        ("{}", ALL, "127.0.0.1", false),
+        (r#"{"other":{"IPAddress":"172.17.0.2"}}"#, ALL, "127.0.0.1", false),
+        (r#"{"bridge":{"IPAddress":"172.17.0.2"},"other":{"IPAddress":"172.18.0.2"}}"#, ALL, "127.0.0.1", false),
+        (r#"{"bridge":{"IPAddress":"127.0.0.1"}}"#, ALL, "127.0.0.1", false),
+        (r#"{"bridge":{"IPAddress":"8.8.8.8"}}"#, ALL, "127.0.0.1", false),
+        (r#"{"bridge":{"IPAddress":""}}"#, ALL, "127.0.0.1", false),
+        (r#"{"bridge":{"IPAddress":"172.17.0.2","IPAddress":"172.17.0.3"}}"#, ALL, "127.0.0.1", false),
+        (good, r#"{"layerfs.role":"sandbox","layerfs.project":"foreign","layerfs.sandbox":"2"}"#, "127.0.0.1", false),
+        (good, ALL, "0.0.0.0", false),
+    ] {
+        let original = inspection(labels, &[STORE]);
+        let response = String::from_utf8(original).unwrap();
+        let (_, body) = response.split_once("\r\n\r\n").unwrap();
+        let body = body.replace(r#""HostConfig":{"#,
+            r#""HostConfig":{"NetworkMode":"bridge","PortBindings":{"30421/tcp":[{"HostIp":"127.0.0.1","HostPort":""}]},"#)
+            .replace(r#""NetworkSettings":{"#,
+            &format!(r#""NetworkSettings":{{"Networks":{networks},"#))
+            .replace(r#""HostIp":"127.0.0.1""#, &format!(r#""HostIp":"{host}""#));
+        let (docker, peer) = Peer::new(vec![inspection(ALL, &[STORE]), fixed(200, body.as_bytes())], 8192);
+        let sandbox = Sandbox::reopen(docker, ContainerId::parse(CID).unwrap(), request(&LABELS)).unwrap();
+        let result = sandbox.endpoint_for(Some("docker-bridge"));
+        assert_eq!(result.is_ok(), accepted, "{networks} {labels} {host}: {result:?}");
+        if let Ok(endpoint) = result { assert_eq!(endpoint.to_string(), "172.17.0.2:30421"); }
+        assert_eq!(peer.finish().len(), 2);
+    }
+}
